# OpenAI API Key (Required if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Configuration: 'huggingface' (free local) or 'openai'
EMBEDDING_PROVIDER=huggingface

# Embedding Model Name
# For OpenAI: text-embedding-3-small
# For HuggingFace: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local Vector Database Store Path
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Open-Access Clinical Diabetes Guideline PDF URL
GUIDELINE_PDF_URL=https://iris.who.int/bitstream/handle/10665/377626/Diabetes-management-protocol-eng.pdf
